{
  "name": "smartisan-ui-vue",
  "version": "1.0.0",
  "description": "Smartisan OS (锤子科技 / 坚果手机) 拟物风格 Vue 3 组件库，基于 Reka UI 与 Tailwind CSS v4 构建。",
  "keywords": [
    "smartisan",
    "smartisan-os",
    "vue",
    "vue3",
    "component-library",
    "skeuomorphism",
    "reka-ui",
    "tailwind"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/smartisan-ui.umd.cjs",
  "module": "./dist/smartisan-ui.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/style.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/smartisan-ui.js",
      "require": "./dist/smartisan-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css",
    "./smartisan-ui.css": "./dist/smartisan-ui.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:app": "vue-tsc -b && vite build --mode app",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.3.0 || ^3.4.0 || ^3.5.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.61.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
